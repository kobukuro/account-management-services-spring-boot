APP_NAME=Your App Name
# JWT Secret Key (MUST be at least 32 characters for HMAC256 security)
SECRET_KEY=your-secret-key-at-least-32-characters-long
FRONTEND_URL=http://localhost:3000
VERIFICATION_TOKEN_EXPIRATION_MILLISECONDS=0
ACCESS_TOKEN_EXPIRATION_MILLISECONDS=0
REFRESH_TOKEN_EXPIRATION_MILLISECONDS=0
RESET_PASSWORD_TOKEN_EXPIRATION_MILLISECONDS=0
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
TRUSTED_PROXY_IPS=127.0.0.1,::1

# AWS S3 Configuration
# For local development with LocalStack (recommended):
# - Set AWS_S3_ENDPOINT to http://localhost:4566
# - Use dummy credentials: AWS_ACCESS_KEY_ID=test, AWS_SECRET_ACCESS_KEY=test
# - Make sure LocalStack container is running: docker compose up -d localstack
# For production (real AWS S3):
# - Leave AWS_S3_ENDPOINT empty or remove it
# - Use real AWS credentials or rely on EC2 instance profile
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# File Upload Configuration
FILE_UPLOAD_MAX_SIZE_MB=5
FILE_UPLOAD_PROFILE_PICTURE_MAX_WIDTH=400
FILE_UPLOAD_PROFILE_PICTURE_MAX_HEIGHT=400

FILE_STORAGE_PRESIGNED_URL_EXPIRATION_HOURS=24